    "    produto = input('Digite aqui o nome do produto: ')\n",
    "    produto = produto.lower()\n",
    "    produto = produto.strip()\n",
    "    print(f'O produto é {produto} foi cadastrado com sucesso !!!')\n",
    "    return produto \n",
    "\n",
    "cadastrar_produto()"
